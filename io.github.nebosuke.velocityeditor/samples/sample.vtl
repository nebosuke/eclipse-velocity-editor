## This is a sample Velocity Template file
## Use this to test the editor features

#*
  Multi-line comment
  This demonstrates the comment highlighting
*#

<!DOCTYPE html>
<html>
<head>
    <title>$pageTitle</title>
    <meta charset="UTF-8" />
    <link rel="stylesheet" href="$cssPath" />
</head>
<body>
    <header>
        <h1>Welcome, ${user.name}!</h1>
    </header>

    <main>
        ## Conditional directive
        #if($user.isLoggedIn)
            <p>Hello, $!{user.displayName}</p>
        #elseif($user.isGuest)
            <p>Welcome, Guest!</p>
        #else
            <p>Please log in.</p>
        #end

        ## Loop directive
        <h2>Items List</h2>
        <ul>
        #foreach($item in $items)
            <li class="item-$foreach.index">
                $item.name - $item.price
                #if($foreach.last)
                    (Last item!)
                #end
            </li>
        #end
        </ul>

        ## Variable assignment
        #set($total = 0)
        #foreach($item in $items)
            #set($total = $total + $item.price)
        #end
        <p>Total: $total</p>

        ## Include another template
        #parse("footer.vtl")
    </main>

    <footer>
        <p>&copy; 2024 Yatsuke Works</p>
    </footer>
</body>
</html>
